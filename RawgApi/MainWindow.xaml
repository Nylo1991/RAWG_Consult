<Window x:Class="AppWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Painel de Captura RAWG - Aluno 1" Height="600" Width="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="300" Margin="0,0,10,0" Text="{Binding SearchTerm}" />
            <Button Content="Buscar na RAWG API" Width="150" Command="{Binding FetchFromRawgCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding GamesList}" AutoGenerateColumns="True" IsReadOnly="True" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Margin="0,0,20,0" VerticalAlignment="Center" Foreground="Green"/>
            <Button Content="Salvar no SQLite Local" Width="150" Margin="0,0,10,0" Command="{Binding SaveLocalCommand}"/>
            <Button Content="Enviar para API do Grupo (Nuvem)" Width="200" Background="#FF0078D7" Foreground="White" Command="{Binding SendToBackendCommand}"/>
        </StackPanel>
    </Grid>
</Window>